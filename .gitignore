.Rhistory
.RData
.Rproj.user/
.quarto/
_book/

/.quarto/
**/*.quarto_ipynb

# Private trainer notes/drafts (local only, never published).
# NOTE the leading slash: it anchors these to the repository root. A bare
# `notes/` matches ANY directory named `notes` at any depth -- which silently
# excluded reveal.js's own `slides/builders_files/libs/revealjs/plugin/notes/`,
# leaving the published deck unable to initialise.
/notes/
/tmp/

# Solver working directories. `solve_scen()` writes `scenarios/<name>/` relative
# to the working directory, so rendering a slide deck that solves leaves one in
# slides/ (3.6 MB from the two decks). Deliberately NOT anchored with a leading
# slash: these can appear wherever a chunk happens to solve.
scenarios/
